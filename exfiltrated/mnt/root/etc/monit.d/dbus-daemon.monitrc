#
#    Description:
#      This file is the control and configuration file for the
#      daemon-monitoring daemon, monit, for the DBus daemon.
#
#      The DBus daemon cannot effectively be restarted, so we
#      request a reboot when the daemon failure is detected.
#

check process dbus-daemon matching /bin/dbus-daemon
  start program = "/sbin/reboot"
  stop program = "/sbin/reboot"
