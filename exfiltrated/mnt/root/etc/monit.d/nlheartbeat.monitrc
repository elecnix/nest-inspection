#
#    Description:
#      This file is the control and configuration file for the
#      daemon-monitoring daemon, monit, for the Nest Heartbeat
#      Software / Watchdog process, nlheartbeat.
#

check process nlheartbeatd matching /nestlabs/sbin/nlheartbeatd
  start program = "/etc/init.d/heartbeat monit_start"
  stop  program = "/etc/init.d/heartbeat monit_stop"
