#
# Description:
# This file is the control and configuration file for the
# daemon-monitoring daemon, monit, for the Nest Learning
# Thermostat process, wpa_supplicant.
#
check process wpa_supplicant matching /sbin/wpa_supplicant
  start program = "/etc/init.d/wpasupplicant monit_start"
  stop program = "/etc/init.d/wpasupplicant monit_stop"
  if mem > 3000 KB for 5 cycles then restart
